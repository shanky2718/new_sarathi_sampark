// Prisma Schema for Sarathi Sampark Logistics Platform
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  Truck_Owner       @map("Truck Owner")
  Transporter
  Driver
  Fleet_Manager     @map("Fleet Manager")
  Shipper_Business  @map("Shipper / Business")
  Admin
}

enum TruckStatus {
  Active
  Delayed
  Maintenance
  Available
}

enum DriverStatus {
  Active
  Inactive
}

enum LoadStatus {
  Available
  Accepted
  Completed
}

enum TripStatus {
  Scheduled
  In_Progress @map("In Progress")
  Completed
  Delayed
  Cancelled
}

enum DeliveryStatus {
  Order_Confirmed @map("Order Confirmed")
  Picked_Up       @map("Picked Up")
  In_Transit      @map("In Transit")
  Near_Destination @map("Near Destination")
  Delivered
}

enum DocumentCategory {
  RC
  Insurance
  PUC
  Driving_License @map("Driving License")
  GST_Certificate @map("GST Certificate")
  Invoice
  E_Way_Bill      @map("E-Way Bill")
  Permit
}

enum DocumentStatus {
  Verified
  Pending
  Expiring_Soon @map("Expiring Soon")
  Expired
}

enum MaintenanceStatus {
  Scheduled
  In_Progress @map("In Progress")
  Completed
  Overdue
}

enum ExpenseCategory {
  Fuel
  Maintenance
  Toll
  Driver_Expenses @map("Driver Expenses")
  Insurance
  Other
}

enum NotificationType {
  warning
  info
  success
}

enum ComplaintPriority {
  Low
  Medium
  High
  Urgent
}

enum ComplaintStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
  Closed
}

enum ContactStatus {
  Unread
  Read
  Replied
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  mobile       String?    @unique
  passwordHash String     @map("password_hash")
  role         RoleType   @default(Transporter)
  companyName  String?    @default("Sarathi Transports") @map("company_name")
  gstNumber    String?    @map("gst_number")
  address      String?    @db.Text
  city         String?
  state        String?
  pincode      String?
  fleetSize    String?    @map("fleet_size")
  avatar       String?    @db.Text
  onboarded    Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  trucks          Truck[]
  drivers         Driver[]
  trips           Trip[]
  deliveries      Delivery[]
  documents       DigitalDocument[]
  fuelMetrics     FuelMetric[]
  maintenance     MaintenanceRecord[]
  expenses        Expense[]
  notifications   Notification[]
  complaints      Complaint[]
  loginHistory    LoginHistory[]

  @@map("users")
}

model Truck {
  id              Int         @id @default(autoincrement())
  userId          Int?        @map("user_id")
  truckId         String      @unique @map("truck_id")
  plateNumber     String      @unique @map("plate_number")
  model           String
  type            String
  capacity        String
  driver          String      @default("Unassigned")
  status          TruckStatus @default(Available)
  location        String      @default("Bengaluru")
  fuel            Int         @default(100)
  mileage         Int         @default(0)
  nextService     DateTime?   @map("next_service")
  insuranceExpiry DateTime?   @map("insurance_expiry")
  fitnessExpiry   DateTime?   @map("fitness_expiry")
  pucExpiry       DateTime?   @map("puc_expiry")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("trucks")
}

model Driver {
  id             Int          @id @default(autoincrement())
  userId         Int?         @map("user_id")
  name           String
  phone          String       @unique
  photo          String?      @db.Text
  assignedTruck  String?      @default("Unassigned") @map("assigned_truck")
  tripsCompleted Int          @default(0) @map("trips_completed")
  rating         Decimal      @default(4.80) @db.Decimal(3, 2)
  safetyScore    Int          @default(95) @map("safety_score")
  licenseNumber  String       @unique @map("license_number")
  status         DriverStatus @default(Active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("drivers")
}

model ReturnLoad {
  id                Int        @id @default(autoincrement())
  loadId            String     @unique @map("load_id")
  pickup            String
  destination       String
  distance          Int
  cargo             String
  weight            String
  offeredPrice      Decimal    @map("offered_price") @db.Decimal(12, 2)
  estimatedFuelCost Decimal    @map("estimated_fuel_cost") @db.Decimal(12, 2)
  estimatedProfit   Decimal    @map("estimated_profit") @db.Decimal(12, 2)
  verifiedShipper   Boolean    @default(true) @map("verified_shipper")
  shipperName       String     @map("shipper_name")
  shipperRating     Decimal    @default(4.80) @map("shipper_rating") @db.Decimal(3, 2)
  postedTime        String     @default("Just now") @map("posted_time")
  status            LoadStatus @default(Available)
  pickupDate        DateTime?  @map("pickup_date")
  requiredTruckType String     @default("Container") @map("required_truck_type")
  acceptedByTruck   String?    @map("accepted_by_truck")
  acceptedAt        DateTime?  @map("accepted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("return_loads")
}

model Trip {
  id          Int        @id @default(autoincrement())
  userId      Int?       @map("user_id")
  tripId      String     @unique @map("trip_id")
  truck       String
  driver      String
  origin      String
  destination String
  distance    Int
  startTime   DateTime   @map("start_time")
  eta         DateTime
  status      TripStatus @default(In_Progress)
  progress    Int        @default(0)
  currentLat  Decimal?   @default(12.971598) @map("current_lat") @db.Decimal(10, 6)
  currentLng  Decimal?   @default(77.594566) @map("current_lng") @db.Decimal(10, 6)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("trips")
}

model Delivery {
  id               Int            @id @default(autoincrement())
  userId           Int?           @map("user_id")
  deliveryId       String         @unique @map("delivery_id")
  customer         String
  pickup           String
  destination      String
  truck            String
  driver           String
  expectedDelivery DateTime       @map("expected_delivery")
  status           DeliveryStatus @default(In_Transit)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("deliveries")
}

model DigitalDocument {
  id             Int              @id @default(autoincrement())
  userId         Int?             @map("user_id")
  docId          String           @unique @map("doc_id")
  title          String
  category       DocumentCategory
  entity         String
  uploadDate     DateTime         @map("upload_date")
  expiryDate     DateTime?        @map("expiry_date")
  status         DocumentStatus   @default(Verified)
  fileSize       String           @default("1.5 MB") @map("file_size")
  documentNumber String           @unique @map("document_number")
  fileUrl        String?          @map("file_url") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("digital_documents")
}

model FuelMetric {
  id                 Int      @id @default(autoincrement())
  userId             Int?     @map("user_id")
  metricId           String   @unique @map("metric_id")
  truckId            String   @map("truck_id")
  plateNumber        String   @map("plate_number")
  driver             String
  fuelConsumedLiters Int      @map("fuel_consumed_liters")
  fuelCost           Decimal  @map("fuel_cost") @db.Decimal(12, 2)
  avgKmL             Decimal  @map("avg_km_l") @db.Decimal(4, 2)
  baselineKmL        Decimal  @default(4.80) @map("baseline_km_l") @db.Decimal(4, 2)
  anomalyPercentage  Decimal  @default(0.00) @map("anomaly_percentage") @db.Decimal(5, 2)
  hasAnomaly         Boolean  @default(false) @map("has_anomaly")
  anomalyReason      String?  @map("anomaly_reason") @db.Text
  lastRefillDate     DateTime @map("last_refill_date")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("fuel_metrics")
}

model MaintenanceRecord {
  id             Int               @id @default(autoincrement())
  userId         Int?              @map("user_id")
  recordId       String            @unique @map("record_id")
  truckId        String            @map("truck_id")
  plateNumber    String            @map("plate_number")
  serviceType    String            @map("service_type")
  scheduledDate  DateTime          @map("scheduled_date")
  completedDate  DateTime?         @map("completed_date")
  cost           Decimal           @db.Decimal(12, 2)
  status         MaintenanceStatus @default(Scheduled)
  mechanicCenter String            @map("mechanic_center")
  notes          String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("maintenance_records")
}

model Expense {
  id          Int             @id @default(autoincrement())
  userId      Int?            @map("user_id")
  expenseId   String          @unique @map("expense_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  truck       String
  description String          @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int?             @map("user_id")
  notifId   String           @unique @map("notif_id")
  type      NotificationType @default(info)
  message   String           @db.Text
  timeAgo   String           @default("Just now") @map("time_ago")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Complaint {
  id          Int               @id @default(autoincrement())
  complaintId String            @unique @map("complaint_id")
  userId      Int?              @map("user_id")
  subject     String
  description String            @db.Text
  priority    ComplaintPriority @default(Medium)
  status      ComplaintStatus   @default(Open)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("complaints")
}

model ContactMessage {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  mobile    String?
  company   String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(Unread)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("contact_messages")
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  email     String
  loginTime DateTime @default(now()) @map("login_time")
  logoutTime DateTime? @map("logout_time")
  status    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_history")
}
